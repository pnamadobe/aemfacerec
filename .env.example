# Adobe I/O Runtime Credentials
AIO_runtime_namespace=your_namespace
AIO_runtime_auth=your_auth_key

# Default AEM Author Host (can also be passed dynamically from AEM Assets View host context)
AEM_HOST=https://author-p12345-e67890.adobeaemcloud.com

# Secret key used to encrypt customer AWS Rekognition Secret Access Keys at rest
ENCRYPTION_SECRET=change-me-to-a-32-byte-secret-key!

# Optional default AWS Rekognition credentials (customers can configure/override in the Settings UI)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_COLLECTION_ID=aem-assets-faces
