# Adobe I/O Runtime Credentials
AIO_runtime_namespace=your_namespace
AIO_runtime_auth=your_auth_key

# Default AEM Author Host (can also be passed dynamically from AEM Assets View host context)
AEM_HOST=https://author-p12345-e67890.adobeaemcloud.com
AEM_AUTHOR_URL=https://author-p12345-e67890.adobeaemcloud.com

# Comma-separated extra AEM author origins (beyond author-pXXX-eYYY.adobeaemcloud.com) that the
# web actions may contact on behalf of a signed-in user. Leave empty in most deployments.
AEM_ALLOWED_HOSTS=

# REQUIRED. Secret used to derive per-tenant AES-256-GCM keys for encrypting customer AWS credentials at rest.
# Generate with: openssl rand -base64 32   (actions refuse to start in Runtime without it)
ENCRYPTION_SECRET=

# Enables seedDemoData / clearAllData / exportSnapshot / importSnapshot. Keep false in production.
ENABLE_MAINTENANCE_OPS=false

# Technical-account OAuth Server-to-Server credentials, used ONLY by background Adobe I/O Events (ingest-event)
AEM_SC_JSON=
AEM_DEV_TOKEN=
